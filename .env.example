# Copy this file to `.env` for local development. Never commit real credentials.
QUANT_RAAS_ENVIRONMENT=development
QUANT_RAAS_LOG_LEVEL=INFO
QUANT_RAAS_CONFIG_DIRECTORY=./configs
QUANT_RAAS_DATA_DIRECTORY=./data
QUANT_RAAS_DATABASE_ECHO=false
QUANT_RAAS_MARKET_DATA_PROVIDER=fixture

# SQLite keeps the default developer path self-contained. Docker Compose
# overrides this with the PostgreSQL URL shown below.
QUANT_RAAS_DATABASE_URL=sqlite+pysqlite:///./quant_raas.db
# QUANT_RAAS_DATABASE_URL=postgresql+psycopg://quant_raas:local-development-only@db:5432/quant_raas

# Settings dictionaries use JSON when supplied through environment variables.
# QUANT_RAAS_DEFAULT_BENCHMARK_IDENTIFIER=SPX
# QUANT_RAAS_SECTOR_BENCHMARK_IDENTIFIERS={"Information Technology":"XLK"}
# QUANT_RAAS_BENCHMARK_MAPPING_FILE=./configs/benchmark_mappings.yaml

# Local-only PostgreSQL values used by docker-compose.yml.
POSTGRES_DB=quant_raas
POSTGRES_USER=quant_raas
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Application ports. They do not imply that a public endpoint is production-ready.
API_PORT=8000
DASHBOARD_PORT=8501

# Public and official-source connectors are disabled until explicitly configured.
# Set to `yahoo` only after installing `.[public-data]` and accepting its
# prototype-only limitations.
# QUANT_RAAS_MARKET_DATA_PROVIDER=yahoo
# SEC_USER_AGENT=Research Team research-ops@example.com

# Bloomberg normally authenticates through an entitled local or server session.
# BLOOMBERG_HOST=host.docker.internal
# BLOOMBERG_PORT=8194

# LSEG values vary by desktop versus platform mode. Add only the values required
# by the approved session type; do not place them in source-controlled files.
# LSEG_APP_KEY=
# LSEG_CLIENT_ID=
# LSEG_CLIENT_SECRET=
